/dist/USERCAP_R10/** -text whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol
/config/*.ini -text whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol
/config/profiles/*.ini -text whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol

